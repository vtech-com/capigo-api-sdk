            "required": true,
            "description": "Code of the tenant to scope the request to.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "properties": {
                    "variant_id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Present → UPDATE existing variant. Absent → CREATE new variant (name required)."
