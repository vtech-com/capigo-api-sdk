    "/pcms/products/{id}/variants": {
      "put": {
        "summary": "Upsert product variants",
        "description": "Create or update variants of a product. Mixed operations are supported in a single call: items with `variant_id` are updated; items without `variant_id` are created (and require `name`). Maximum 50 items per call.",
        "tags": [
          "PCMS"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
